---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { compareLessonOrder } from "../content/lesson-order";
const lessonEntries = (await getCollection("lessons"))
	.filter((lesson) => lesson?.data)
	.sort(compareLessonOrder);
const courseCatalog = [
	{
		id: "html",
		firstLesson: "your-first-page",
		number: "01",
		title: "HTML",
		text: "Learn how webpages are structured.",
		icon: "〈/〉",
	},
	{
		id: "css",
		firstLesson: "selectors",
		number: "02",
		title: "CSS",
		text: "Learn how to style and design webpages.",
		icon: "✳",
	},
	{
		id: "javascript",
		firstLesson: "variables",
		number: "03",
		title: "JavaScript",
		text: "Learn how to make webpages interactive.",
		icon: "JS",
	},
	{
		id: "python",
		firstLesson: "variables",
		number: "04",
		title: "Python",
		text: "Learn programming fundamentals with Python.",
		icon: "Py",
	},
];
const courses = courseCatalog.map((course) => {
	const firstLesson = lessonEntries.find((lesson) => lesson.data.course === course.id);
	return { ...course, lesson: firstLesson?.data.slug ?? course.firstLesson };
});
---

<html lang="en" class="scroll-smooth scroll-pt-20" transition:animate="none">
	<head>
		<ClientRouter />
		<meta charset="utf-8" /><meta
			name="viewport"
			content="width=device-width"
		/>
		<meta
			name="description"
			content="Join the OSDC Full Stack Development Workshop and learn how to build for the web through guided lessons and hands-on coding."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Full Stack Development Workshop · OSDC</title>
	</head>
	<body
		class="m-0 bg-page font-sans text-base leading-relaxed text-ink transition-colors duration-200 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-accent [&_a:focus-visible]:outline-offset-2 [&_button:focus-visible]:outline-2 [&_button:focus-visible]:outline-accent [&_button:focus-visible]:outline-offset-2"
	>
		<header
			class="topbar sticky top-0 z-20 flex h-16 items-center gap-8 px-16 max-[760px]:px-5"
		>
			<a
				class="brand flex items-center gap-2"
				href="/"
				aria-label="OSDC home"
				><img class="brand-logo h-14 w-20 object-cover" src="/osdc_logo.png" alt="OSDC" /></a
			>
			<nav
				class="top-links flex h-full items-center gap-7 max-[760px]:hidden"
				aria-label="Main navigation"
			>
				<a
					class="flex h-full items-center border-b-2 border-transparent transition-colors"
					href="/html/your-first-page">HTML</a
				><a
					class="flex h-full items-center border-b-2 border-transparent transition-colors"
					href="/css/selectors">CSS</a
				><a
					class="flex h-full items-center border-b-2 border-transparent transition-colors"
					href="/javascript/variables">JavaScript</a
				><a
					class="flex h-full items-center border-b-2 border-transparent transition-colors"
					href="/python/variables">Python</a>
			</nav>
			<div class="ml-auto flex items-center gap-3.5">
				<button
					class="search-trigger flex h-8 items-center gap-2 rounded-md px-2.5 max-[760px]:size-8 max-[760px]:justify-center max-[760px]:border-0 max-[760px]:bg-transparent max-[760px]:p-0"
					data-search-open
					aria-label="Search lessons"
					><span>⌕</span><span class="max-[760px]:hidden"
						>Search lessons</span
					><kbd class="max-[760px]:hidden">⌘ K</kbd></button
				><button
					class="theme-trigger flex items-center gap-2.5 rounded-md px-2.5 max-[760px]:hidden"
					data-theme-cycle
					aria-label="Change color theme"
					><span aria-hidden="true">◐</span><span class="theme-label"
						>System</span
					></button
				><a
					class="icon-link grid size-8 place-items-center max-[760px]:hidden [&_svg]:size-4"
					href="https://github.com/gaurishhs/learn-fullstack"
					aria-label="GitHub"
					><svg viewBox="0 0 24 24" aria-hidden="true"
						><path
							d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.5 6.1-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.8 1.4a13.2 13.2 0 0 0-6.9 0C5.4 1.1 4.2 1.5 4.2 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.1 6.4 6.1 6.7a3.4 3.4 0 0 0-.9 2.7V22"
						></path></svg
					></a
				><button
					class="mobile-menu hidden max-[760px]:block"
					data-menu-open
					aria-label="Open course menu">☰</button>
			</div>
		</header>
		<main class="mx-auto max-w-5xl px-7 max-[760px]:px-5">
			<section
				id="workshop"
				class="hero grid min-h-120 grid-cols-2 items-center gap-14 py-20 max-[760px]:min-h-0 max-[760px]:grid-cols-1 max-[760px]:gap-7 max-[760px]:px-0 max-[760px]:py-14"
			>
				<div class="hero-copy pb-2">
					<h1
						class="my-5 mb-3.5 text-6xl max-[760px]:my-4 max-[760px]:mb-3 max-[760px]:text-5xl"
					>
						Full Stack<br />Development<br />Workshop<span class="period">.</span>
					</h1><p class="hero-subtitle mb-6 text-lg">
						A hands-on OSDC workshop to learn how the web works, from your first HTML page to interactive experiences. Learn at your own pace with guided lessons and code you can edit and run.
					</p><div class="flex gap-2.5">
						<a
							class="button button-primary inline-flex min-h-10 items-center justify-center gap-4 rounded-md px-4"
							href="/html/your-first-page"
							>Get started <span aria-hidden="true">↗</span></a
						><a
							class="button button-secondary inline-flex min-h-10 items-center justify-center gap-4 rounded-md px-4"
							href="#topics">Explore topics</a>
					</div>
				</div>
				<div
					class="hero-art relative flex h-76 items-center justify-center max-[760px]:h-60 max-[420px]:h-52"
					aria-hidden="true"
				>
					<div
						class="art-window h-64 w-full max-w-106 overflow-hidden max-[760px]:h-56 max-[420px]:h-52"
					>
						<div
							class="window-top flex h-8 items-center gap-1 px-3"
						>
							<span class="size-1.5 rounded-full bg-neutral-300"></span><span
								class="size-1.5 rounded-full bg-neutral-300"></span><span
								class="size-1.5 rounded-full bg-neutral-300"></span><i
								class="ml-auto text-xs not-italic text-faint"
								>your-first-page.html</i>
						</div><div
							class="art-code relative h-24 px-5 py-3 max-[760px]:h-20"
						>
							<div class="flex gap-4">
								<b class="text-xs text-faint">1</b><span
									class="code-purple">&lt;main&gt;</span>
							</div><div class="flex gap-4">
								<b class="text-xs text-faint">2</b><span
									class="code-blue"
									>&nbsp;&nbsp;&lt;h1&gt;</span
								>Hello, web!<span class="code-blue"
									>&lt;/h1&gt;</span>
							</div><div class="flex gap-4">
								<b class="text-xs text-faint">3</b><span
									class="code-purple">&lt;/main&gt;</span>
							</div><div
								class="art-cursor absolute left-56 top-12 h-3.5 w-px"
							>
							</div>
						</div><div
							class="art-preview relative mx-3 h-32 max-[760px]:h-28 max-[420px]:h-24"
						>
							<span
								class="block"
								>YOUR PAGE</span
							><strong
								class="block text-base font-semibold tracking-tight"
								>Hello, web!</strong
							><i class="block text-xs text-muted"
								>Every great site starts somewhere.</i
							><div
								class="preview-button absolute right-3.5 bottom-3 px-2 py-1"
							>
								Say hello <b class="ml-2">↗</b>
							</div>
						</div>
					</div><div
						class="spark absolute right-3 top-2"
					>
						✳
					</div><div
						class="spark spark-two absolute bottom-1 left-2"
					>
						✦
					</div>
				</div>
			</section>
			<section
				id="topics"
				class="courses-section border-t py-10 pb-16 max-[760px]:py-7 max-[760px]:pb-12"
				aria-labelledby="courses-title"
			>
				<div class="section-heading mb-5 flex items-end justify-between">
					<div>
						<div
							class="text-xs font-semibold tracking-widest text-muted"
						>
							WORKSHOP TOPICS
						</div><h2
							class="m-0 mt-2"
							id="courses-title"
						>
							What you’ll explore
						</h2>
					</div><span class="section-count"
						>01 — 04</span>
				</div><div
					class="grid grid-cols-4 gap-3 max-[1000px]:grid-cols-2 max-[760px]:grid-cols-1"
				>
					{
						courses.map((course) => (
							<a
								class="course-card relative min-h-40 p-4 transition max-[760px]:min-h-28 max-[760px]:p-3"
								href={`/${course.id}/${course.lesson}`}
							>
								<>
									<div class="flex items-center justify-between">
										<>
											<span
												class:list={["course-symbol", course.id]}
											>
												{course.icon}
											</span>
											<span class="course-number">
												{course.number}
											</span>
										</>
									</div>
									<h3 class="mb-1 mt-5 max-[760px]:mt-2">
										{course.title}
									</h3>
									<p class="m-0">
										{course.text}
									</p>
									<span
										class="course-arrow absolute bottom-4 right-4"
										aria-hidden="true"
									>
										↗
									</span>
								</>
							</a>
						))
					}
				</div>
			</section>
			<section
				class="path-section grid grid-cols-2 gap-24 border-t border-line py-10 max-[760px]:grid-cols-1 max-[760px]:gap-5 max-[760px]:py-7"
			>
				<div class="path-intro">
					<div
						class="text-xs font-semibold tracking-widest text-muted"
					>
						HOW THE WORKSHOP WORKS
					</div><h2
						class="m-0 mt-2"
					>
						Learn it. Try it. Make it yours.
					</h2><p class="mt-3 mb-0 max-w-72">
						Follow a guided path through the building blocks of the web. Read a short lesson, edit a live example, and keep experimenting as you go.
					</p>
				</div><ol class="path-list m-0 list-none p-0">
					<li
						class="grid grid-cols-3 items-center border-b border-line py-2 max-[760px]:grid-cols-3 max-[420px]:grid-cols-3"
					>
						<span class="course-number">01</span
						><strong >Learn</strong><i
							class="not-italic"
							>Understand each new idea</i>
					</li><li
						class="grid grid-cols-3 items-center border-b border-line py-2 max-[760px]:grid-cols-3 max-[420px]:grid-cols-3"
					>
						<span class="course-number">02</span
						><strong >Practice</strong><i
							class="not-italic"
							>Edit and run code in your browser</i>
					</li><li
						class="grid grid-cols-3 items-center border-b border-line py-2 max-[760px]:grid-cols-3 max-[420px]:grid-cols-3"
					>
						<span class="course-number">03</span
						><strong
							>Explore</strong
						><i class="not-italic"
							>Build on what you’ve learned</i>
					</li><li
						class="grid grid-cols-3 items-center border-b border-line py-2 max-[760px]:grid-cols-3 max-[420px]:grid-cols-3"
					>
						<span class="course-number">04</span
						><strong
							>Continue</strong
						><i class="not-italic"
							>Follow the lessons at your pace</i>
					</li>
				</ol>
			</section>
			<footer
				class="home-footer flex min-h-16 items-center justify-between border-t max-[760px]:flex-wrap max-[760px]:gap-2"
			>
				<a
					class="brand flex items-center gap-2"
					href="/"
					><img class="brand-logo h-14 w-20 object-cover" src="/osdc_logo.png" alt="OSDC" /></a
				><span class="max-[760px]:hidden"
					>Open learning from OSDC.</span
				><a class="text-ink" href="/html/your-first-page"
					>Get started <b class="ml-1.5">↗</b></a>
			</footer>
		</main>
		<div
			class="search-dialog fixed inset-0 z-50 hidden aria-[hidden=false]:block"
			data-search-dialog
			aria-hidden="true"
		>
			<div
				class="absolute inset-0 bg-black/40 backdrop-blur-sm"
				data-search-close
			>
			</div><section
				class="absolute inset-x-4 top-16 mx-auto w-auto max-w-xl overflow-hidden rounded-lg border border-line bg-surface shadow-panel max-[760px]:top-12"
				role="dialog"
				aria-modal="true"
				aria-label="Search lessons"
			>
				<div
					class="search-input-wrap flex h-13 items-center gap-3 border-b border-line px-3"
				>
					<span >⌕</span><input
						class="min-w-0 flex-1 border-0 bg-transparent text-sm text-ink outline-none"
						data-search-input
						type="search"
						placeholder="Search lessons..."
						aria-label="Search lessons"
					/><kbd
						class="rounded-sm border border-line px-1 text-xs text-faint"
						>ESC</kbd>
				</div><div
					class="max-h-80 overflow-y-auto p-1.5"
					data-search-results
					aria-live="polite"
				>
					<p class="search-hint">
						Search lessons by title or topic.
					</p>
				</div><div
					class="search-foot flex h-8 items-center justify-between border-t px-3"
				>
					<span>↑↓ to navigate</span><span>↵ to select</span>
				</div>
			</section>
		</div>
		<div
			class="fixed inset-0 z-50 hidden aria-[hidden=false]:block"
			data-mobile-drawer
			aria-hidden="true"
		>
			<div
				class="absolute inset-0 bg-black/40 backdrop-blur-sm"
				data-menu-close
			>
			</div><nav
				class="drawer-panel absolute inset-y-0 right-0 flex w-80 max-w-full flex-col gap-1 bg-page p-5 shadow-panel"
				aria-label="Course navigation"
			>
				<div class="drawer-head mb-5 flex items-center justify-between">
					<a
						class="brand flex items-center gap-2"
						href="/"
						><img class="brand-logo h-14 w-20 object-cover" src="/osdc_logo.png" alt="OSDC"
						></a
					><button data-menu-close aria-label="Close menu">×</button>
				</div><span
					class="drawer-label"
					>LEARN</span
				><a
					class="flex justify-between rounded px-2 py-2.5 text-sm hover:bg-soft"
					href="/html/your-first-page"
					>HTML <small class="text-faint">Start here</small></a
				><a
					class="flex justify-between rounded px-2 py-2.5 text-sm hover:bg-soft"
					href="/css/selectors"
					>CSS <small class="text-faint">Style your page</small></a
				><a
					class="flex justify-between rounded px-2 py-2.5 text-sm hover:bg-soft"
					href="/javascript/variables"
					>JavaScript <small class="text-faint"
						>Make it interactive</small
					></a
				><a
					class="flex justify-between rounded px-2 py-2.5 text-sm hover:bg-soft"
					href="/python/variables"
					>Python <small class="text-faint">Learn fundamentals</small></a
				><button
					class="theme-trigger mt-5 flex items-center gap-2.5 self-start rounded-md px-2.5"
					data-theme-cycle
					>◐ <span class="theme-label">System</span></button>
			</nav>
		</div>
		<script>
			import { initializeSite } from "../scripts/site";
			initializeSite();
		</script>
	</body>
</html>
