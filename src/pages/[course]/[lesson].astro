---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { compareLessonOrder, lessonNumberFromFile } from "../../content/lesson-order";

const lessonEntries = await getCollection("lessons");
const nav = ["html", "css", "javascript", "python"]
  .map((course) => ({
    course,
    lessons: lessonEntries
      .filter((item) => item.data.course === course)
      .sort(compareLessonOrder),
  }))
  .filter((group) => group.lessons.length > 0);
const courseKey = Astro.params.course;
export async function getStaticPaths() {
  const lessons = await getCollection("lessons");
  const courseOrder = ["html", "css", "javascript", "python"];
  const orderedLessons = courseOrder.flatMap((course) =>
    lessons
      .filter((lesson) => lesson.data.course === course)
      .sort(compareLessonOrder),
  );
  return orderedLessons.map((lesson, index) => {
    const previous = orderedLessons[index - 1];
    const next = orderedLessons[index + 1];
    return {
      params: { course: lesson.data.course, lesson: lesson.data.slug },
      props: {
        lesson,
        lessonNumber: lessonNumberFromFile(
          lesson,
          lessons
            .filter((entry) => entry.data.course === lesson.data.course)
            .sort(compareLessonOrder)
            .findIndex((entry) => entry.id === lesson.id) + 1,
        ),
        previousLesson: previous
          ? {
              course: previous.data.course,
              slug: previous.data.slug,
              title: previous.data.title,
            }
          : undefined,
        nextLesson: next
          ? {
              course: next.data.course,
              slug: next.data.slug,
              title: next.data.title,
            }
          : undefined,
      },
    };
  });
}
const entry = Astro.props.lesson;
const lesson = entry.data;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const lessonNumber = String(Astro.props.lessonNumber).padStart(2, "0");
const previousLesson = Astro.props.previousLesson;
const nextLesson = Astro.props.nextLesson;
const courseLabel =
  lesson.course === "javascript" ? "JavaScript" : lesson.course.toUpperCase();
const nextUrl = nextLesson
  ? `/${nextLesson.course}/${nextLesson.slug}`
  : undefined;
const previousUrl = previousLesson
  ? `/${previousLesson.course}/${previousLesson.slug}`
  : "/";
---

<html lang="en">
  <head
    ><ClientRouter /><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={lesson.description} /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    /><title>{lesson.title} · OSDC</title></head
  >
  <body>
    <header
      class="topbar sticky top-0 z-20 flex h-16 items-center gap-8 px-16 max-[760px]:px-5"
    >
      <a class="brand flex items-center gap-2" href="/"
        ><img
          class="brand-logo h-14 w-20 object-cover"
          src="/osdc_logo.png"
          alt="OSDC"
        /></a
      ><nav
        class="top-links flex h-full items-center gap-7 max-[760px]:hidden"
        aria-label="Main navigation"
      >
        <a
          class="flex h-full items-center border-b-2 border-transparent transition-colors"
          class:list={[courseKey === "html" && "active"]}
          href="/html/your-first-page">HTML</a
        ><a
          class="flex h-full items-center border-b-2 border-transparent transition-colors"
          class:list={[courseKey === "css" && "active"]}
          href="/css/selectors">CSS</a
        ><a
          class="flex h-full items-center border-b-2 border-transparent transition-colors"
          class:list={[courseKey === "javascript" && "active"]}
          href="/javascript/js-core">JavaScript</a
        ><a
          class="flex h-full items-center border-b-2 border-transparent transition-colors"
          class:list={[courseKey === "python" && "active"]}
          href="/python/variables">Python</a
        >
        
      </nav><div class="ml-auto flex items-center gap-3.5">
        <button
          class="search-trigger flex h-8 items-center gap-2 px-2.5 max-[760px]:size-8 max-[760px]:justify-center max-[760px]:border-0 max-[760px]:bg-transparent max-[760px]:p-0"
          data-search-open
          aria-label="Search lessons"
          ><span>⌕</span><span class="search-label max-[760px]:hidden"
            >Search lessons</span
          ><kbd class="max-[760px]:hidden">⌘ K</kbd></button
        ><button
          class="theme-trigger flex items-center gap-2.5 px-2.5 max-[760px]:hidden"
          data-theme-cycle
          aria-label="Change color theme"
          >◐ <span class="theme-label">System</span></button
        ><a
          class="icon-link grid size-8 place-items-center max-[760px]:hidden [&_svg]:size-[17px]"
          href="https://github.com/gaurishhs/learn-fullstack"
          aria-label="GitHub"
          ><svg viewBox="0 0 24 24" aria-hidden="true"
            ><path
              d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.1-1.5 6.1-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.8 1.4a13.2 13.2 0 0 0-6.9 0C5.4 1.1 4.2 1.5 4.2 1.5a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.1 6.4 6.1 6.7a3.4 3.4 0 0 0-.9 2.7V22"
            ></path></svg
          ></a
        ><button
          class="mobile-menu hidden max-[760px]:block"
          data-menu-open
          aria-label="Open course menu">☰</button
        >
      </div>
    </header>
    <div
      class="mx-auto grid max-w-7xl grid-cols-[15rem_minmax(0,42.5rem)_12rem] justify-between gap-10 px-12 max-[1100px]:grid-cols-[13rem_minmax(0,1fr)] max-[1100px]:gap-8 max-[1100px]:px-8 max-[760px]:block max-[760px]:px-5"
    >
      <aside
        class="sticky top-16 h-[calc(100dvh-4rem)] self-start overflow-y-auto overscroll-contain border-r border-line py-7 pr-5 max-[760px]:hidden"
        data-course-sidebar
        transition:persist="course-sidebar"
      >
        {
          nav.map(({ course, lessons }) => (
            <section class="sidebar-group mb-5">
              <>
                <h2 class="m-0 mb-2">{course}</h2>
                <ul class="m-0 list-none p-0">
                  {lessons.map((item) => (
                    <li>
                      <a
                        class="relative block rounded px-2 py-1.5"
                        class:list={[
                          "sidebar-link",
                          item.data.slug === lesson.slug && "current",
                        ]}
                        href={`/${course}/${item.data.slug}`}
                        aria-current={
                          item.data.slug === lesson.slug ? "page" : undefined
                        }
                      >
                        {item.data.title}
                        {item.data.slug === lesson.slug && (
                          <span class="current-mark absolute -left-px top-2 h-3 w-0.5 rounded bg-accent" />
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            </section>
          ))
        }
      </aside>
      <main class="min-w-0 py-8 pb-16">
        <div class="lesson-heading border-b border-line pb-6">
          <div class="eyebrow text-xs font-semibold tracking-widest text-muted">
            {courseLabel.toUpperCase()}
            <span>·</span> LESSON {lessonNumber}
          </div><h1 class="my-2 mb-2 text-4xl max-[760px]:text-3xl">
            {lesson.title}
          </h1><p class="m-0 max-w-2xl">
            {lesson.description}
          </p>
        </div><div class="lesson-body-content pt-6"><Content /></div><nav
          class="lesson-navigation mt-10 grid grid-cols-2 gap-2.5 border-t border-line pt-4"
          aria-label="Lesson navigation"
        >
          <a class="flex flex-col gap-0.5" href={previousUrl}
            ><span>← Previous</span><strong>{previousLesson?.title ?? "Course overview"}</strong></a
          >{
            nextLesson && (
              <a class="next-link flex flex-col gap-0.5" href={nextUrl}>
                <>
                  <span>Next lesson →</span>
                  <strong>{nextLesson.title}</strong>
                </>
              </a>
            )
          }
        </nav>
      </main>
      <aside
        class="sticky top-16 h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain pt-24 max-[1100px]:hidden"
        data-page-toc
      >
        <div class="toc-title mb-3">ON THIS PAGE</div>{tocHeadings.map((heading) => (
          <a class="toc-link block border-l py-1.5 pl-3" href={`#${heading.slug}`}>{heading.text}</a>
        ))}
      </aside>
    </div>
    <div
      class="fixed inset-0 z-50 hidden aria-[hidden=false]:block"
      data-search-dialog
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 bg-black/40 backdrop-blur-sm"
        data-search-close
      >
      </div><section
        class="absolute inset-x-4 top-16 mx-auto w-auto max-w-xl overflow-hidden rounded-lg border border-line bg-surface shadow-panel max-[760px]:top-12"
        role="dialog"
        aria-modal="true"
        aria-label="Search lessons"
      >
        <div
          class="flex h-13 items-center gap-3 border-b border-line px-3 text-muted"
        >
          <span>⌕</span><input
            class="min-w-0 flex-1 border-0 bg-transparent text-sm text-ink outline-none"
            data-search-input
            type="search"
            placeholder="Search lessons..."
            aria-label="Search lessons"
          /><kbd class="rounded-sm border border-line px-1 text-xs text-faint"
            >ESC</kbd
          >
        </div><div
          class="max-h-80 overflow-y-auto p-1.5"
          data-search-results
          aria-live="polite"
        >
        </div><div
          class="flex h-8 items-center justify-between border-t border-line px-3 text-xs text-faint"
        >
          <span>↑↓ to navigate</span><span>↵ to select</span>
        </div>
      </section>
    </div>
    <div
      class="fixed inset-0 z-50 hidden aria-[hidden=false]:block"
      data-mobile-drawer
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 bg-black/40 backdrop-blur-sm"
        data-menu-close
      >
      </div><nav
        class="drawer-panel absolute inset-y-0 right-0 flex w-80 max-w-full flex-col gap-1 bg-page p-5 shadow-panel"
        aria-label="Course navigation"
      >
        <div class="drawer-head mb-5 flex items-center justify-between">
          <a class="brand flex items-center gap-2" href="/"
            ><img
              class="brand-logo h-14 w-20 object-cover"
              src="/osdc_logo.png"
              alt="OSDC"
            /></a
          ><button data-menu-close aria-label="Close menu">×</button>
        </div>{
          nav.map(({ course, lessons }) => (
            <>
              <span class="drawer-label">{course.toUpperCase()}</span>
              {lessons.map((item) => (
                <a
                  class="flex items-center rounded px-2 py-2.5 text-sm hover:bg-soft"
                  href={`/${course}/${item.data.slug}`}
                >
                  {item.data.title}
                </a>
              ))}
            </>
          ))
        }<button
          class="theme-trigger mt-5 flex items-center gap-2.5 self-start px-2.5"
          data-theme-cycle>◐ <span class="theme-label">System</span></button
        >
      </nav>
    </div>
    <script>
      import { initializeSite } from "../../scripts/site";
      initializeSite();
    </script>
  </body>
</html>
